# Environment for the deployed stack (deploy/docker-compose.yml). Copy to
# deploy/.env. Separate from the repo-root .env, which configures the host-run
# development flow and is never baked into an image.
#
# The file is read twice: compose interpolates ${...} from it, and the app
# containers receive it as their environment. Anything the app doesn't
# recognise is ignored, so the two groups below can share one file.

# --- app settings -----------------------------------------------------------
# DATABASE_NAME, STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY have no defaults:
# the app raises at startup without them.
DATABASE_NAME=audiopipeline
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=audio

# Hugging Face read token for diar-pyannote. Its weights are gated: the account
# must have accepted the conditions on the model in sidecars/diar_pyannote.
HF_TOKEN=

# --- where the stores are ---------------------------------------------------
# Unset, these default to the `stores` profile's own containers, so
# `docker compose --profile stores up -d` is a complete deployment. Point them
# at an existing Postgres/MinIO to use those instead — and leave the profile
# off, which is what `make stack-up` does.
#
# An external store must be reachable from this stack's bridge. If it is itself
# a container publishing a host port, it has to be on a *different* bridge:
# Docker skips published-port DNAT for traffic arriving on the target's own.
#DATABASE_HOST=192.0.2.10
#STORAGE_ENDPOINT_URL=http://192.0.2.10:9000

# --- what gets published ----------------------------------------------------
# The web tier serves plain HTTP for a TLS-terminating proxy in front of it.
#WEB_BIND=0.0.0.0
#WEB_PORT=8098

# The sidecars, and the `stores` profile's Postgres/MinIO, are published only
# so a host-run `make api` / `make worker` can reach them at the ports the code
# defaults to. Widen the bind, or move the ports off a conflict, as needed.
#SIDECAR_BIND=127.0.0.1
#STORE_BIND=127.0.0.1
#POSTGRES_PORT=5432
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001

# --- adopting existing weight caches ----------------------------------------
# Model weights are tens of gigabytes. If they already exist under another
# volume name, name it here rather than re-downloading; EXTERNAL=true also
# stops `docker compose down -v` from deleting it.
#ASR_HF_CACHE=some-existing-volume
#ASR_HF_CACHE_EXTERNAL=true
#DIAR_HF_CACHE=some-existing-volume
#DIAR_HF_CACHE_EXTERNAL=true
#TAGGER_HF_CACHE=some-existing-volume
#TAGGER_HF_CACHE_EXTERNAL=true
