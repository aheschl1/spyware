# Environment for the deployed stack (deploy/docker-compose.yml). Copy to
# deploy/.env. This is separate from the repo-root .env, which configures the
# host-run development flow and is never baked into an image.
#
# Only credentials and identifiers belong here. Addresses are set by the
# compose file, which points the containers at the shared stores and at the
# sidecars by service name.

# --- shared Postgres (the `postgress` container in ~/docker_deployments) -----
# DATABASE_NAME has no default: the app fails to start without it.
DATABASE_NAME=audiopipeline
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# --- shared MinIO -----------------------------------------------------------
# Scoped credentials, minted by builds/minio_add_service.sh audio audiopipeline.
# Both are required — neither has a default.
STORAGE_ACCESS_KEY=audiopipeline
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=audio

# --- diar-pyannote ----------------------------------------------------------
# Hugging Face read token. The pyannote weights are gated: the account must
# have accepted the conditions on pyannote/speaker-diarization-community-1.
HF_TOKEN=
