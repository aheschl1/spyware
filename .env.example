DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=audiopipeline
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# Blob store holding the raw audio. In development this is the shared `minio`
# service in ~/docker_deployments (bytes in ~/docker_deployments/minio). It is
# shared with other services, so this app gets its own credentials scoped to the
# `audio` bucket -- mint them with:
#     ~/docker_deployments/builds/minio_add_service.sh audio audiopipeline
# Any S3-compatible provider works — only these values change.
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=audiopipeline
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=audio
