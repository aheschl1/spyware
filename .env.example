DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=audiopipeline
DATABASE_USER=app
DATABASE_PASSWORD=change-me

STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=audiopipeline
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=audio

# Streaming websocket (docs/streaming-protocol.md); defaults shown.
#API_STREAM_MAX_CHUNK_BYTES=8388608
#API_STREAM_ACK_WINDOW_CHUNKS=10
#API_STREAM_ACK_WINDOW_SECONDS=2.0
#API_STREAM_HELLO_TIMEOUT_SECONDS=10
#API_STREAM_IDLE_TIMEOUT_SECONDS=300
#API_STREAM_SESSION_CHECK_SECONDS=5.0
# Protocol v2: per-frame PCM cap and frame pooling into stored segments.
# MAX_LATENCY is also the worst-case ack lag a v2 client sees.
#API_STREAM_MAX_AUDIO_FRAME_BYTES=65536
#API_STREAM_POOL_TARGET_BYTES=262144
#API_STREAM_POOL_MAX_BUFFER_BYTES=1048576
#API_STREAM_POOL_MAX_LATENCY_SECONDS=10.0
#API_STREAM_POOL_FLUSH_RETRIES=3
#API_STREAM_POOL_RETRY_BACKOFF_SECONDS=1.0
#API_SESSION_STALE_SECONDS=300
#API_SESSION_SWEEP_INTERVAL_SECONDS=60
# Split every open session at this local time daily (processing starts, a
# connected client is told to reopen); unset disables. TZ decides "local".
#API_SESSION_ROTATE_AT=03:30
# Covers a CLAP reload when the tagger sidecar idle-unloads (IDLE_UNLOAD_SECONDS).
#API_CLASSIFIER_TIMEOUT_SECONDS=180

# Live processing worker, spawned by the API (docs/processing-pipelines.md,
# "Live pipelines"); defaults shown. Empty SOCKET_PATH picks a pid-suffixed
# path under /tmp/audio-pipeline/.
#LIVE_ENABLED=true
#LIVE_WAKEWORD=hey pipeline
#LIVE_SOCKET_PATH=
#LIVE_PREROLL_MS=2000
#LIVE_GATE_WINDOW_MS=30000
#LIVE_TAP_QUEUE_FRAMES=256
#LIVE_PIPELINE_QUEUE_FRAMES=256
#LIVE_RECONNECT_BACKOFF_SECONDS=0.5
#LIVE_SHUTDOWN_GRACE_SECONDS=5.0
#LIVE_RESTART_BACKOFF_BASE_SECONDS=1.0
#LIVE_RESTART_BACKOFF_CAP_SECONDS=30.0

# Processing workers (docs/processing-pipelines.md); defaults shown.
#PROCESSING_POLL_INTERVAL_SECONDS=5.0
#PROCESSING_DISCOVERY_BATCH=100
#PROCESSING_MAX_ATTEMPTS=5
#PROCESSING_RETRY_BACKOFF_BASE_SECONDS=2.0
#PROCESSING_RETRY_BACKOFF_CAP_SECONDS=300.0
#PROCESSING_SHUTDOWN_GRACE_SECONDS=20.0
#PROCESSING_RESTART_BACKOFF_BASE_SECONDS=1.0
#PROCESSING_RESTART_BACKOFF_CAP_SECONDS=30.0
#PROCESSING_RESTART_RESET_SECONDS=60.0

# Speech detection (the VAD tier); defaults shown.
#PROCESSING_VAD_BACKEND=silero
#PROCESSING_VAD_THRESHOLD=0.15
#PROCESSING_VAD_MIN_SPEECH_MS=250
#PROCESSING_VAD_MERGE_GAP_MS=2500
#PROCESSING_VAD_PAD_MS=200
#PROCESSING_VAD_MAX_SPAN_MS=30000
#PROCESSING_VAD_ENERGY_THRESHOLD=500

# Transcription tier: the asr_parakeet container (or any backend speaking the
# standard transcriptions API; protocol "cog" for Replicate cog images).
#PROCESSING_TRANSCRIBER_BASE_URL=http://127.0.0.1:8033/v1
#PROCESSING_TRANSCRIBER_MODEL=nvidia/parakeet-tdt-0.6b-v3
#PROCESSING_TRANSCRIBER_PROTOCOL=openai
#PROCESSING_TRANSCRIBER_TIMEOUT_SECONDS=600

# Diarization tier: the diar_pyannote container.
#PROCESSING_DIARIZER_BASE_URL=http://127.0.0.1:8034/v1
#PROCESSING_DIARIZER_TIMEOUT_SECONDS=900

# Audio-tag tier: the audio_tagger container (CED sound classes + CLAP
# embeddings per window). The API's text->audio search uses the same service
# (API_CLASSIFIER_BASE_URL, same default).
#PROCESSING_CLASSIFIER_BASE_URL=http://127.0.0.1:8035/v1
#PROCESSING_CLASSIFIER_TIMEOUT_SECONDS=600
#PROCESSING_AUDIO_TAG_SPAN_MS=120000
#PROCESSING_AUDIO_TAG_WINDOW_MS=10000
#PROCESSING_AUDIO_TAG_HOP_MS=5000
#PROCESSING_AUDIO_TAG_WINDOW_MIN_SCORE=0.15
#PROCESSING_AUDIO_TAG_THRESHOLD=0.3
#PROCESSING_AUDIO_TAG_MIN_CONSECUTIVE=2
#PROCESSING_AUDIO_TAG_TOP_K=15

# Sound-span tier: the tagger's windows merged into few long single-class
# spans. A span opens at ENTER and holds while SUSTAIN does; SUSTAIN must stay
# above PROCESSING_AUDIO_TAG_WINDOW_MIN_SCORE or the service's floor decides.
#PROCESSING_SOUND_SPAN_ENTER_SCORE=0.35
#PROCESSING_SOUND_SPAN_SUSTAIN_SCORE=0.2
#PROCESSING_SOUND_SPAN_BRIDGE_GAP_MS=5000
#PROCESSING_SOUND_SPAN_MIN_WINDOWS=2
#PROCESSING_SOUND_SPAN_TOP_K=8
#PROCESSING_SOUND_SPAN_MAX_SPANS=2000
#PROCESSING_DIARIZE_BLOCK_MERGE_GAP_MS=30000
#PROCESSING_DIARIZE_MAX_BLOCK_MS=1800000
#PROCESSING_DIARIZE_MIN_TURN_MS=300
#PROCESSING_DIARIZE_UTTERANCE_MERGE_GAP_MS=1500
#PROCESSING_DIARIZE_MAX_UTTERANCE_MS=30000
# Speaker clustering defaults; a cluster_params row overrides them per user.
#PROCESSING_CLUSTER_DISTANCE=0.65
#PROCESSING_CLUSTER_MIN_TALK_MS=3000
